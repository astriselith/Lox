fun readonly() {
	return {
		fun init(value) -> value;
		fun write(currentValue, newValue)  ->  currentValue;
	};
}

fun range(min,  max) {
	return {
		fun clamp(val) {
			if (val < min) return min;
			if (val > max) return max;
			return val;
		}

		fun init(initialValue) -> clamp(initialValue);
		fun write(currentValue, newValue) -> clamp(newValue);
	};
}
@readonly
var i = 0;
i = 100;

@range(0, 100)
var j = 0;

j = 500;

println(i);
println(j);