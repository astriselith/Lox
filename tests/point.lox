// Definindo um "tipo" usando bloco com parâmetros
fun Point(px, py) {
	return {
		x: px;
		y: py;
		fun distance(other) {
			var dx = x - other.x;
			var dy = y - other.y;
			return sqrt(dx * dx + dy * dy);
		}
	};
}

// Criando instâncias
var p1 = Point(10, 20);
var p2 = Point(30, 40);

println(p1.distance(p2));